{
  "name": "order-report-legacy",
  "version": "1.0.0",
  "description": "Legacy order report system - Refactoring test",
  "main": "legacy/orderReportLegacy.ts",
  "scripts": {
    "legacy": "ts-node legacy/orderReportLegacy.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "start": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.5.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.2"
  }
}
